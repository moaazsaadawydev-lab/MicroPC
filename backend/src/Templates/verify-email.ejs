<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Activate Your MicroPC Account</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <style>
    body {
      margin: 0;
      padding: 0;
      width: 100% !important;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
      background-color: #f8fafc;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    img {
      border: 0;
      height: auto;
      line-height: 100%;
      outline: none;
      text-decoration: none;
    }
    table {
      border-collapse: collapse !important;
    }
    .cta-button:hover {
      background-color: #4338ca !important;
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3) !important;
    }
  </style>
</head>
<body style="margin: 0; padding: 0; width: 100%; background-color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1e293b;">
  <table width="100%" border="0" cellpadding="0" cellspacing="0" style="background-color: #f8fafc; width: 100%;">
    <tr>
      <td align="center" style="padding: 40px 20px;">
        <!-- Container Table -->
        <table class="container" width="100%" border="0" cellpadding="0" cellspacing="0" style="max-width: 580px; width: 100%; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -2px rgba(0,0,0,0.05); border: 1px solid #e2e8f0;">
          
          <!-- Top Accent Bar (Gradient) -->
          <tr>
            <td height="6" style="background: linear-gradient(90deg, #4f46e5 0%, #818cf8 100%); background-color: #4f46e5;"></td>
          </tr>

          <!-- Header / Brand Logo -->
          <tr>
            <td align="center" style="padding: 32px 32px 20px 32px;">
              <span style="font-size: 26px; font-weight: 800; letter-spacing: -0.5px; color: #4f46e5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
                Micro<span style="color: #1e293b;">PC</span>
              </span>
            </td>
          </tr>

          <!-- Main Email Content -->
          <tr>
            <td style="padding: 20px 32px 32px 32px;">
              <h1 style="margin: 0 0 16px 0; font-size: 22px; font-weight: 700; color: #0f172a; text-align: center; line-height: 30px;">Verify your email address</h1>
              
              <p style="margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #334155;">
                Hello <strong><%= locals.name %></strong>
              </p>
              
              <p style="margin: 0 0 24px 0; font-size: 16px; line-height: 24px; color: #475569;">
                Thank you for creating an account with MicroPC. To complete your registration and activate your account, please click the button below to verify your email address.
              </p>

              <!-- CTA Button -->
              <table width="100%" border="0" cellpadding="0" cellspacing="0" style="margin-bottom: 28px;">
                <tr>
                  <td align="center">
                    <a href="<%= locals.verificationLink %>" class="cta-button" target="_blank" style="display: inline-block; padding: 14px 32px; font-size: 16px; font-weight: 600; color: #ffffff; text-decoration: none; background-color: #4f46e5; border-radius: 8px; transition: all 0.2s ease-in-out; box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.2), 0 2px 4px -2px rgba(79, 70, 229, 0.2);">
                      Verify Email Address
                    </a>
                  </td>
                </tr>
              </table>

              <!-- Warning Box -->
              <table width="100%" border="0" cellpadding="0" cellspacing="0" style="background-color: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 28px;">
                <tr>
                  <td style="padding: 16px;">
                    <table width="100%" border="0" cellpadding="0" cellspacing="0">
                      <tr>
                        <td width="28" valign="top" style="font-size: 16px; line-height: 20px;">
                          ⏱️
                        </td>
                        <td style="font-size: 13px; line-height: 20px; color: #475569;">
                          For security reasons, this link will expire in <strong>24 hours</strong>. If you did not request this, you can safely ignore this email.
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Fallback Link -->
              <table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-top: 1px solid #e2e8f0; padding-top: 20px;">
                <tr>
                  <td style="font-size: 13px; line-height: 20px; color: #64748b;">
                    <p style="margin: 0 0 8px 0;">If you're having trouble clicking the button, copy and paste the URL below into your web browser:</p>
                    <p style="margin: 0; word-break: break-all;">
                      <a href="<%= locals.verificationLink %>" target="_blank" style="color: #4f46e5; text-decoration: none;"><%= locals.verificationLink %></a>
                    </p>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer Section -->
          <tr>
            <td style="background-color: #f1f5f9; padding: 24px 32px; border-top: 1px solid #e2e8f0; text-align: center;">
              <p style="margin: 0 0 8px 0; font-size: 14px; font-weight: 600; color: #475569;">The MicroPC Team</p>
              <p style="margin: 0 0 16px 0; font-size: 12px; color: #64748b;">Your Premium Tech Destination</p>
              <p style="margin: 0; font-size: 11px; color: #94a3b8; line-height: 16px;">
                &copy; 2026 MicroPC. All rights reserved.<br>
                This is an automated message. Please do not reply directly to this email.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
